t is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Move the words from the box to complete the conversation.", "type": "text"}]}, {"content": 2, "type": "template_override"}], "id": 9, "type": "SFL"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "type": "RSLT"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "enpe7n1le01ob03re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": "Let's see if you have any questions! ", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}], "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"_data": [], "type": "welcome", "template_override": 1, "id": 0, "contents": [{}]}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "id": 1, "contents": [{"value": {"coverimg": "enpe7n1le01ob03re2img01.jpg", "images": [{"time": "0", "text": "<span class=\"strong\">Mr. West: </span> Hi, Monique! Nice to see you! <br />\n<span class=\"strong\">Monique: </span> Good morning, Mr. West! Nice to see you too. <br />\n<span class=\"strong\">Mr. West: </span>Tell me, why do you need a tutoring session? <br />\n<span class=\"strong\">Monique: </span> Because I need help with the algorithm topic. There are some things that I don't understand. <br />\n<span class=\"strong\">Mr. West: </span> OK, I see. <br />\n<span class=\"strong\">Monique: </span> In class, you always say that an algorithm is a procedure which permits a computer to solve a problem, but last class you said that it is a series of unambiguous instructions, what does it mean? <br />", "image": "enpe7n1le01ob03re2img01.jpg", "id": 0}, {"time": "33300", "text": "<span class=\"strong\">Mr. West: </span> Well, it means that there isn't any kind of subjective interpretation of the algorithm. A computer performs all kinds of operations you want. For example, it makes a spell check when you finish a text, or it uses a search engine when you need to seek information. Therefore, computers need the algorithms to do all these procedures. Tell me, what does it mean to you? <br />\n<span class=\"strong\">Monique: </span> I understand that we use an algorithm to make a computer solve a problem. Every time I command the computer to do a task, it uses the same algorithm to solve the problem, it always works like this, and there are no other different interpretations of it. <br />", "image": "enpe7n1le01ob03re2img02.jpg", "id": 1}, {"time": "81000", "text": "<span class=\"strong\">Mr. West: </span> Excellent! You are a quick learner, but how does the computer understand the instructions that are part of the algorithm? <br />\n<span class=\"strong\">Monique: </span> That's easy! You need to use a programming language so that the computer can understand the algorithm. Does the algorithm always work like that? <br />\n<span class=\"strong\">Mr. West: </span> Not really, there are now different ways to optimize the process. These approaches make the algorithm solve the problem faster and efficiently. <br />\n<span class=\"strong\">Monique: </span> Does it work algorithm by algorithm? <br />\n<span class=\"strong\">Mr. West: </span> Yes, it does. You optimize the algorithm to solve a particular problem at a time. <br />", "image": "enpe7n1le01ob03re2img03.jpg", "id": 2}], "audiosrc": "enpe7n1le01ob03re2aud01"}, "type": "slideshow"}]}], "id": 0, "type": "scholar"}]}